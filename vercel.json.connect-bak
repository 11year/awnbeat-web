{
  "buildCommand": null,
  "outputDirectory": ".",
  "framework": null,
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path((?!\\.well-known/apple-app-site-association$).*)",
      "has": [
        {
          "type": "host",
          "value": "www.awnbeat.com"
        }
      ],
      "destination": "https://awnbeat.com/:path*",
      "permanent": true
    },
    {
      "source": "/privacy-policy",
      "destination": "/privacy/",
      "permanent": true
    },
    {
      "source": "/privacy-policy/",
      "destination": "/privacy/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/events/:eventId",
      "destination": "/api/event?eventId=:eventId"
    },
    {
      "source": "/communities/:entityId",
      "destination": "/api/open-app?resource=communities&entityId=:entityId"
    },
    {
      "source": "/groups/:entityId",
      "destination": "/api/open-app?resource=groups&entityId=:entityId"
    },
    {
      "source": "/posts/:entityId",
      "destination": "/api/open-app?resource=posts&entityId=:entityId"
    },
    {
      "source": "/profile/:entityId",
      "destination": "/api/open-app?resource=profile&entityId=:entityId"
    },
    {
      "source": "/chats/:entityId",
      "destination": "/api/open-app?resource=chats&entityId=:entityId"
    }
  ]
}
